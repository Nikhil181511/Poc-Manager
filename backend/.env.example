APP_NAME="POC Intelligence Platform"
APP_ENV=development
DEBUG=true

# Database & Queue
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/poc_platform
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET_KEY=change_this_in_production_super_secret_key_12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Models & Providers
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=google
VECTOR_DB_PROVIDER=pgvector

# LangChain & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=poc-intelligence-platform

# CORS & Upload Limits
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
